  <order>
    <hop>
      <from>input census death</from>
      <to>output census death</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>input census death</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>dwh_conn</connection>
    <sql>select
r.id, 
r.birth_date, 
r.gender,
r.patient_id, 
d.id as patient_admission_id,
d.admission_ward_id ,
d.encounter_id,
d.patient_visit_id,
w.name as ward_name,
d.admission_date,
d.medical_discharge_date,
p.place_of_death ,
p.date_created,
p.time_of_death
FROM dwh.dim_eafya_registered_patients r
inner join dwh.fact_eafya_patient_visit v on v.patient_id = r.patient_id
inner join dwh.fact_eafya_admissions d on d.patient_visit_id = v.id
inner join  dwh.dim_eafya_ward w on w.id = d.admission_ward_id 
inner join dwh.fact_eafya_deceased_patient p on p.patient_visit_id = v.id
WHERE p.time_of_death > '${LAST_RUN_DATE}';


</sql>
    <limit>0</limit>
