, back_condition
, chest_condition
, ears_condition
, eyes_condition
, first_name
, gender
, general_condition
, genitalia_condition
, head_condition
, hip_joints_condition
, last_name
, lower_limbs_condition
, mouth_condition
, neck_condition
, newborn_complication
, newborn_pmtct
, nose_condition
, other_name
, reflexes_condition
, third_apgar_score
, upper_limbs_condition
, baby_gender
FROM "import".eafya_newborn
</sql>
