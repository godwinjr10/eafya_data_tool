    <connection>ugandaemr</connection>
    <sql>SELECT
  person_id
, gender
, DATE_FORMAT(birthdate, '%Y-%m-%d') AS birthdate
, dead
, DATE_FORMAT(death_date, '%Y-%m-%d') AS death_date
, cause_of_death
, creator
, DATE_FORMAT(date_created, '%Y-%m-%d') AS date_created
, changed_by
, DATE_FORMAT(date_changed, '%Y-%m-%d') AS date_changed
FROM openmrs.person</sql>
