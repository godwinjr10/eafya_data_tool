    <connection>local_conn</connection>
    <sql>SELECT
  id
, version
, bed_type
, branch_id
, company_id
, created_by_id
, date_created
, description
, is_available
, is_system_defined
, last_updated
, max_occupants
, "name"
, room_id
FROM "public".bed
WHERE date_created > '${LAST_RUN_DATE}'

</sql>
