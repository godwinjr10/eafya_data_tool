, last_updated
, membranes_complete
, mother_status
, parity
, patient_admission_id
, perineal_tear
, placenta_complete
, placental_weight
, pulse
, repair
, respiratory_rate
, ruptured_membranes
, second_stage_duration
, temperature
, vaginal_exams_count
, edd
, lmp
, obstetric_care
, obstetric_complication
, pregnancy_history
FROM "public".patient_labour_monitor
</sql>
